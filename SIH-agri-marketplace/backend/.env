PROJECT_NAME="SIH 2026 Agricultural Marketplace API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration:
# For local instant demo:
DATABASE_URL=sqlite:///./agri_marketplace.db

# For PostgreSQL production deployment (e.g. Supabase, RDS, or local Docker):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agri_marketplace

# JWT Security
SECRET_KEY=sih2026-production-super-secret-jwt-key-change-in-production-environment-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
